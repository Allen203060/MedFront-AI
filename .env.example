# ==========================================
# AURACARE AI VOICE PLATFORM CONFIGURATION
# ==========================================

# --- General & App Settings ---
ENVIRONMENT="development"
LOG_LEVEL="INFO"
APP_HOST="0.0.0.0"
APP_PORT=8000

# --- Module 1: Azure Communication Services (ACS) ---
ACS_CONNECTION_STRING="endpoint=https://<your-acs-resource>.communication.azure.com/;accesskey=<your-key>"
ACS_PHONE_NUMBER="+1XXXXXXXXXX"
ACS_CALLBACK_BASE_URL="https://<your-ngrok-or-appservice-url>.azurewebsites.net"

# --- Module 2: Azure AI Speech ---
AZURE_SPEECH_KEY="<your-azure-speech-resource-key>"
AZURE_SPEECH_REGION="eastus"
AZURE_SPEECH_VOICE_NAME="en-US-JennyNeural"

# --- Module 3: Azure OpenAI ---
AZURE_OPENAI_ENDPOINT="https://<your-openai-resource>.openai.azure.com/"
AZURE_OPENAI_API_KEY="<your-azure-openai-key>"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o"

# --- Module 4: Azure AI Search (Scoped RAG) ---
AZURE_SEARCH_ENDPOINT="https://<your-search-resource>.search.windows.net"
AZURE_SEARCH_API_KEY="<your-search-admin-key>"
AZURE_SEARCH_PATIENT_INDEX="patient-records-index"
AZURE_SEARCH_CLINIC_INDEX="clinic-knowledge-index"

# --- Module 5: Azure Cosmos DB ---
COSMOS_DB_ENDPOINT="https://<your-cosmos-account>.documents.azure.com:443/"
COSMOS_DB_KEY="<your-cosmos-primary-key>"
COSMOS_DB_DATABASE_NAME="auracare_db"
COSMOS_DB_PATIENTS_CONTAINER="patients"
COSMOS_DB_APPOINTMENTS_CONTAINER="appointments"

# --- Feature Flags ---
USE_MANAGED_IDENTITY=false
ENABLE_BARGE_IN=true
